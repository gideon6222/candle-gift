; Engine configuration file.
; Regenerated by Godot when the editor saves; edit it by hand only for things
; the editor cannot set, and read the diff when it rewrites.

config_version=5

[application]

config/name="Candle Gift"
config/description="Steer a batch of candles down a factory line, dip them in wax, stand them up, stamp and wrap them, and sell them for what they are worth."
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

; THE ANDROID BACK BUTTON IS THE GAME'S, and this line is only half of that.
;
; The other half is NOTIFICATION_WM_GO_BACK_REQUEST in main.gd's _notification,
; which unwinds one layer per press: crash report, shop, pause, run, reward,
; ruler, and only then quits from the home screen. This setting WITHOUT that
; handler is a button that does nothing at all, which reads as a hung app and is
; worse than the default - a player presses a dead button again, harder. Never
; import one without the other.
;
; The unwinding is what is asserted, in run_smoke.gd. This line cannot fail.
config/quit_on_go_back=false

[display]

; Portrait, because that is the only shape these games are played in.
window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; "mobile" is the Vulkan mobile backend - the right default for a modern
; Android phone. "gl_compatibility" is the fallback for old hardware and costs
; real visual features; do not switch to it without measuring first.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

; Required for an Android export - the exporter refuses without it. Mobile
; GPUs want ETC2/ASTC rather than the desktop S3TC/BPTC formats, and importing
; both is what lets one project ship to a phone and a desktop preview.
textures/vram_compression/import_etc2_astc=true

[physics]

; Nothing here uses the physics server - collision is arithmetic in Sim, which
; is what lets the tests run with no scene tree. Left at defaults deliberately
; rather than tuned, so it is obvious it is unused.
common/physics_ticks_per_second=60

[debug]

; EVERY ERROR TO A FILE ON THE DEVICE.
;
; The phone crashes and there is no cable, so a log on the device is the only
; evidence that survives. `blackbox.gd` shows its tail at the next boot when the
; previous session did not exit cleanly.
;
; NO `.pc` OVERRIDE HERE. Godot ships one as its own default, and adding another
; alongside the plain key left `enable_file_logging` reading FALSE at runtime -
; the first build with the black box in it came back from the phone saying "no
; log file - file logging is off", which is exactly the failure this was meant to
; rule out. Verified by printing the setting rather than by reading the docs.
;
; Semicolons, not `#`: project.godot is a ConfigFile.
file_logging/enable_file_logging=true
file_logging/max_log_files=4
